{
  "name": "unhuntable-server",
  "version": "0.1.0",
  "private": true,
  "description": "Unhuntable backend: jobs, sign-in and calls to OutLayer for users",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/migrations dist/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "ISC",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.8",
    "pino": "^9.14.0",
    "unhuntable-client": "file:../client",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
