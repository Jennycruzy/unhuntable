{
  "name": "unhuntable-client",
  "version": "0.1.0",
  "description": "Client for the unhuntable guard: sealed calls over OutLayer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./planner": {
      "types": "./dist/planner.d.ts",
      "default": "./dist/planner.js"
    },
    "./fills": {
      "types": "./dist/fills.d.ts",
      "default": "./dist/fills.js"
    },
    "./vrf": {
      "types": "./dist/vrf.d.ts",
      "default": "./dist/vrf.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "default": "./dist/keys.js"
    },
    "./hyperliquid": {
      "types": "./dist/hyperliquid.d.ts",
      "default": "./dist/hyperliquid.js"
    },
    "./exit": {
      "types": "./dist/exit.d.ts",
      "default": "./dist/exit.js"
    },
    "./box-browser": {
      "types": "./dist/box-browser.d.ts",
      "default": "./dist/box-browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "ISC",
  "devDependencies": {
    "@metamask/eth-sig-util": "^8.2.0",
    "@types/node": "^20.19.43",
    "fast-check": "^3.23.2",
    "near-seed-phrase": "^0.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/bip39": "^1.6.0"
  }
}
