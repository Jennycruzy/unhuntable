{
  "name": "unhuntable-client",
  "version": "0.1.0",
  "description": "Client for the unhuntable guard: sealed calls over OutLayer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./planner": {
      "types": "./dist/planner.d.ts",
      "default": "./dist/planner.js"
    },
    "./fills": {
      "types": "./dist/fills.d.ts",
      "default": "./dist/fills.js"
    },
    "./vrf": {
      "types": "./dist/vrf.d.ts",
      "default": "./dist/vrf.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
